# Copy to lima-claw.env and set DEEPSEEK_API_KEY.
#
# Defaults target macOS + Apple Silicon. For additional concurrent instances,
# use a unique INSTANCE_NAME and HOST_PORT per config file.

INSTANCE_NAME=openclaw
VM_TYPE=vz
ARCH=auto
CPUS=2
MEMORY=4GiB
DISK=30GiB

GUEST_PORT=18789
HOST_PORT=18789
HOST_IP=127.0.0.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_VERSION=latest
OPENCLAW_POST_INSTALL_COMMANDS=

# "none" is safe only because the gateway binds inside the guest to loopback
# and Lima forwards it to HOST_IP above. Use "token" plus GATEWAY_AUTH_TOKEN
# if you intentionally widen access.
GATEWAY_AUTH_MODE=none
GATEWAY_AUTH_TOKEN=
